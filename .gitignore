# Local config with secrets/paths
config/wraithlink.conf
**/local.properties
local.properties

# Synced AOSP/GrapheneOS / Lineage source trees (never commit; use `repo`)
wraithlink-src/
wraithlink-lineage-src/
*/out/
out/

