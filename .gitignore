keys/
keys-local/
*.pem
*.pk8
*.x509.pem
*.jks
*.keystore
*.idsig
avb*.bin
id_ed25519*
*.priv

# Build artifacts / releases
releases/
*.zip
*.img
*.apk
*.aab

# Node / gradle / misc
node_modules/
.gradle/
**/.gradle/
build/
*.log
.DS_Store

# Python bytecode
__pycache__/
*.pyc
