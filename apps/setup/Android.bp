// WraithLink Setup - first-boot guided hardening wizard.
// Platform-signed (gets signature-level perms like WRITE_SECURE_SETTINGS,
// MANAGE_USERS by cert match) but NOT privileged, so no privapp-permissions
// allowlist is required (avoids a common user-build boot failure).
package {
    default_applicable_licenses: ["Android-Apache-2.0"],
}

android_app {
    name: "WraithLinkSetup",
    srcs: ["src/**/*.java"],
    resource_dirs: ["res"],
    platform_apis: true,
    certificate: "platform",
    privileged: false,
    optimize: {
        enabled: false,
    },
    dex_preopt: {
        enabled: false,
    },
}
