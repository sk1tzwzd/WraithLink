// WraithLink Lineage Setup — platform-signed wizard with soft panic (device admin).
package {
    default_applicable_licenses: ["Android-Apache-2.0"],
}

android_app {
    name: "WraithLinkSetup",
    srcs: ["src/**/*.java"],
    resource_dirs: ["res"],
    platform_apis: true,
    certificate: "platform",
    privileged: false,
    optimize: {
        enabled: false,
    },
    dex_preopt: {
        enabled: false,
    },
}
